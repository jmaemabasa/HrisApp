<div class="d-flex flex-row align-items-center gap-3">
    <div class="d-flex align-items-center">
        <MudAvatar Rounded="true">
            <img class="imgavatar" src="@ImageData" style="width: inherit;height: inherit;border-radius: inherit;" />
        </MudAvatar>
    </div>
    <div>
        <div class="flex-column">
            <div><b>@CapitalizeFirstLetter(FRSTNAME) @CapitalizeFirstLetter(LSTNAME)</b></div>
            <div style="font-size: 13px !important;">@subpos.Position?.Name</div>
        </div>
    </div>
</div>

@code {
    #nullable disable
    [Parameter] public string VERIFYID { get; set; }
    [Parameter] public int GENDERID { get; set; }
    [Parameter] public string FRSTNAME { get; set; }
    [Parameter] public string LSTNAME { get; set; }
    [Parameter] public int POSID { get; set; }

    private SubPositionT subpos = new();

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            subpos = await PositionService.GetSingleSubPosition(POSID);
            await EmployeeImg(VERIFYID, GENDERID);//image
        }
        catch (Exception)
        {
            ImageData = "images/avatarorimage.jpg";
        }
    }

    private string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return input;
        }

        return char.ToUpper(input[0]) + input[1..];
    }

    private string ImageData = "images/avatarorimage.jpg";

    private async Task EmployeeImg(string verifyCode, int id)
    {
        var imagemodel = await ImageService.GetImageDataCatchByGender(verifyCode, id);
        if (imagemodel != null)
        {
            var base642 = Convert.ToBase64String(imagemodel);
            ImageData = string.Format("data:image/png;base64,{0}", base642);
        }
    }
}
