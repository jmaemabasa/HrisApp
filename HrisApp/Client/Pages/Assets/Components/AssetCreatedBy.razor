<div class="d-flex flex-row align-items-center gap-3" style="cursor: pointer;margin-top: 5px;" @onclick="GoToEmployee">
    <div class="d-flex align-items-center">
        <MudAvatar>
            <img class="imgavatar" src="@ImageData" style="width: inherit;height: inherit;border-radius: inherit;" />
        </MudAvatar>
    </div>
    <div>
        <div class="flex-column">
            <div style="font-weight: 600;color: #757A90;">@fname  @mname  @lname</div>
            <div style="font-size: 13px !important;color: #757A90;">@subpos.Position?.Name</div>
        </div>
    </div>
</div>

@code {
    #nullable disable
    [Parameter]
    public int Id { get; set; }

    EmployeeT employee = new();
    SubPositionT subpos = new();

    private string ImageData;

    string fname = "", lname = "", mname = "", pos = "";

    private void GoToEmployee() => NavigationManager.NavigateTo($"/employee/edit/{employee.Id}");

    protected override async Task OnParametersSetAsync()
    {
        if (Id != 0)
        {
            employee = await EmployeeService.GetSingleEmployee(Id);
            subpos = await PositionService.GetSingleSubPosition(employee.SubPositionId);

            fname = employee.FirstName;
            lname = employee.LastName;
            mname = (employee.MiddleName != "" ? $"{employee.MiddleName[0].ToString().ToUpper()}." : "");
            try
            {
                await EmployeeImg(employee?.Verify_Id);//image
            }
            catch (Exception)
            {
                if (employee.GenderId == 1)
                {
                    ImageData = string.Format("images/avatarmaleholder.jpg");
                }
                else
                {
                    ImageData = string.Format("images/avatarfemaleholder.jpg");
                }
            }
        }
    }

    private async Task EmployeeImg(string verifyCode)
    {
        var imagemodel = await ImageService.GetImageData(verifyCode);
        if (imagemodel != null)
        {
            var base642 = Convert.ToBase64String(imagemodel);
            ImageData = string.Format("data:image/png;base64,{0}", base642);
        }
    }
}
