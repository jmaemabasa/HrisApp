@layout AuthLayout
@page "/"

<style>
    .card {
        background: #e9ecef;
        border: none;
        box-shadow: -5px -5px 10px #ffffff, 5px 5px 10px #cacdcf;
        border-radius: 20px;
    }
</style>
<div class="divbodybg"></div>
<div class="divbodybottomright"></div>
<div class="divbodybottomright1"></div>
<div class="divbodycircle"></div>
<div>
    <div class="logincard">
        <div class="container-fluid testbox">
            <div class="row">
                <div class="col-sm-12 col-md-6 ">
                    <div class='boxcss'>
                        <div class='wave -one'></div>
                        <div class='wave -two'></div>
                        <div class='wave -three'></div>
                    </div>
                    <div><img class="bdgimage" src="./images/bdgs.png" /></div>
                    <div class="contactdiv">
                        <div class="d-flex gap-2 justify-content-center">
                            <div><button class="btn btniconlink" type="button" @onclick="@(() => NavigationManager.NavigateTo("https://www.facebook.com/profile.php?id=100012973324912"))"><img src="./images/facebook.svg" /></button></div>
                            <div><button class="btn btniconlink" type="button" @onclick="@(() => NavigationManager.NavigateTo("https://www.instagram.com/ssdisales/"))"><MudIcon Icon="@Icons.Custom.Brands.Instagram" /></button></div>
                            <div><button class="btn btniconlink" type="button" @onclick="@(() => NavigationManager.NavigateTo("http://sonicsales.net:1337/"))"><img src="./images/logo.png" /></button></div>
                        </div>
                        <div class="d-flex flex-column align-items-center" style="margin-top: 21px;">
                            <div style="font-size: 11px;color: #2c4256;font-weight: bold;">
                                Need Help?
                            </div>
                            <div style="font-size: 12px;margin-top: 4px;color: #2c4256;">
                                0917 803 0153
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 col-md-6">
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex flex-column align-items-center m-auto">
                                @if (_showAlert)
                                {
                                    <img src="./images/SonicSales.png" width="130" alt="" style="margin-top: 24px;">
                                    <div class="loginaccounttext" style="margin-bottom: 7px;">Login Account</div>
                                }
                                else
                                {
                                    <img src="./images/SonicSales.png" width="130" alt="" style="margin-top: 50px;">
                                    <div class="loginaccounttext" style="margin-bottom: 17px;">Login Account</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <EditForm Model="@_log" OnValidSubmit="@HandleLogin" style="padding: 0px 25px;">
                                <DataAnnotationsValidator />
                                @if (_showAlert)
                                {
                                    <MudAlert Severity="@_severity" ShowCloseIcon="true" CloseIconClicked="CloseMe" Class="mb-1 mt-1">@_message</MudAlert>
                                }
                                <div class="row">
                                    <div class="col-12">
                                        <MudText Typo="Typo.caption" Class="labelunpw">Username</MudText>
                                        <InputText class="txf1 w-100" @bind-Value="_log.Username" />
                                        <ValidationMessage For="@(() => _log.Username)" />
                                    </div>
                                </div>

                                <div class="row" style="margin-top: 5px;">
                                    <div class="col-12">
                                        <MudText Typo="Typo.caption" Class="labelunpw">Password</MudText>
                                        <MudTextField DisableUnderLine @bind-Value="_log.Password" InputType="@_passwordInput" Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="ButtonTestclick" AdornmentAriaLabel="Show Password" Class="txtpass w-100" />
                                        <ValidationMessage For="@(() => _log.Password)" />
                                    </div>
                                </div>
                                <div class="row" style="margin-top: 5px;">
                                    <div class="col-12 text-end">
                                        <a href="/" class="w-auto" style="color: #757A90;"><small>Forgot your password?</small></a>
                                    </div>
                                </div>
                                <div class="row" style="margin-top: 20px;">
                                    <div class="col-12">
                                        <div class="d-grid">
                                            <button type="submit" disabled="@_processing" class="btn btnloginbs">
                                                @if (_processing)
                                                {
                                                    <div class="d-flex justify-content-center align-items-center">
                                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                        <div class="ms-2">Signing In</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div>Sign In</div>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

