<script>
    // selecting all sections with class of section
    const sections = document.querySelectorAll(".sectioncore");
    const allsectionMainContActive = document.querySelectorAll(".sectionmaincontactive");
    const allsectionmaincont = document.querySelectorAll(".sectionmaincont");

    // Foreach section when clicked
    sections.forEach((section) => {
        section.addEventListener("click", () => {
            // remove active class from all another section and
            // add it to the selected section
            sections.forEach((s) => {
                s.classList.remove("active");
            });
            section.classList.add("active");

            // Remove all existing background classes from containertest
            const containertest = document.querySelector(".containertest");
            containertest.classList.remove("bg-one", "bg-two", "bg-three", "bg-four", "bg-five");

            // Add the appropriate background class to containertest based on the active section
            const activeSection = document.querySelector(".sectioncore.active");
            const sectionIndex = Array.from(sections).indexOf(activeSection) + 1;
            containertest.classList.add(`bg-${sectionIndex}`);

            // Remove background class if the section is not active
            sections.forEach((s) => {
                if (!s.classList.contains("active")) {
                    const index = Array.from(sections).indexOf(s) + 1;
                    containertest.classList.remove(`bg-${index}`);
                }
            });

            // Toggle active class for sectionmaincontactive based on active state of section
            allsectionMainContActive.forEach((s) => {
                s.classList.remove("active");
            });
            allsectionmaincont.forEach((s) => {
                s.classList.add("active");
            });
            const sectionMainCont = section.querySelector(".sectionmaincont");
            const sectionMainContActive = section.querySelector(".sectionmaincontactive");
            if (section.classList.contains("active")) {
                sectionMainContActive.classList.add("active");
                sectionMainCont.classList.remove("active");
            } else {
                sectionMainContActive.classList.remove("active");
                sectionMainCont.classList.add("active");
            }
        });
    });
</script>


