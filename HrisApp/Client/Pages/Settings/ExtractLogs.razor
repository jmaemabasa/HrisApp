@page "/extract-logs"

@attribute [Authorize(Roles = "CadAdmin, SysAdmin, HR")]

<PageTitle>Extract Logs</PageTitle>

<style>
    /*UPLOAD FILE*/
    .btnUplaod {
        background-color: #f0f0f0 !important;
        padding: 12px 12px;
        color: slategrey;
        border-left: 2px solid #ebe8e8;
    }

        .btnUplaod:hover {
            background-color: slategrey !important;
            padding: 12px 12px;
            color: #f0f0f0;
            /*transform: scale(1.1);*/
            border: none;
        }

    .btnDiaSave {
        color: #fafaf5;
        background-color: #427D9D !important;
        transition: all .5s ease;
    }

        .btnDiaSave:hover {
            transform: scale(1.1);
            color: #fafaf5;
            background-color: #245e7d !important;
        }

    .btnDiaCancel {
        padding-left: 15px;
        padding-right: 13px;
        color: #BE1313;
        background-color: #EABCBB !important;
        transition: all .5s ease;
    }

        .btnDiaCancel:hover {
            transform: scale(1.1);
            background-color: #BE1313 !important;
            color: #fafaf5;
        }
    /*END UPLOAD FILE*/
</style>

<div class="mb-5">
    <div class="d-flex flex-row mt-5 justify-content-between align-items-center">
        <span style="font-size: x-large;font-weight: 600;color: #424242;">Extract Logs</span>
        <AuthorizeView Roles="CadAdmin, SysAdmin, HR">
            <Authorized>
                <div class="d-flex gap-3">
                    <button class="Btn" @onclick="OnCleanLogs">
                        @if (!_processingClean)
                        {
                            <div class="sign"><MudIcon Icon="@Icons.Material.Rounded.CleaningServices"></MudIcon></div>
                            <div class="text">Clean Logs</div>
                        }
                        else
                        {
                            <div class="sign"> <MudProgressCircular Color="Color.Warning" Class="ms-n1" Size="Size.Small" Indeterminate="true" /></div>
                            <div class="text">Cleaning</div>
                        }

                    </button>
                    <MudDatePicker @bind-Date="dateextract"
                                   IsDateDisabledFunc="@((DateTime dt) => dt.Date >= DateTime.Today.AddDays(1))" Variant="Variant.Outlined" Margin="Margin.Dense" />

                    <MudSelect @bind-Value="SelectedLoc" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="0">Select Location</MudSelectItem>
                        @foreach (var div in bioipList)
                        {
                            <MudSelectItem Value="@div.Id">@div.Location</MudSelectItem>
                        }
                    </MudSelect>

                    @if (ISPROCESSING)
                    {
                        <MudButton OnClick="ExtractBtn" Variant="Variant.Filled" Size="Size.Medium" Class="btnadd" Disabled>
                            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="me-1" />
                            Extracting
                        </MudButton>
                    }
                    else
                    {
                        <MudButton OnClick="ExtractBtn" Variant="Variant.Filled" Size="Size.Medium" StartIcon="@Icons.Material.Rounded.Download" Class="btnadd"> Extract</MudButton>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="box w-auto">
    <div class="d-flex justify-content-end">
        <div class="ssize">
            <MudTextField DisableUnderLine @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="tsearch mb-5" Immediate=true Margin="Margin.Dense" />
        </div>
    </div>
    @if (_extractLogsList == null || _extractLogsList.Count == 0)
    {
        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-7" hidden="@_isVisible" />

        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="auto" hidden="@_isVisible" />
        <MudCardContent hidden="@_isVisible">
            <MudSkeleton Width="30%" Height="42px;" />
            <MudSkeleton Width="80%" />
            <MudSkeleton Width="100%" />
        </MudCardContent>
        <MudCardActions hidden="@_isVisible">
            <MudSkeleton Width="64px" Height="40px" Class="ml-2" />
            <MudSkeleton Width="105px" Height="40px" Class="ml-3" />
        </MudCardActions>
        @if (_isVisible == true)
        {
            <div class="divnodata">
                <MudImage Src="images/nodata.png" Alt="No Data" Width="332" Height="220" Class="rounded-lg" />
                <span class="nodataspan">No Data Available</span>
            </div>
        }
    }
    else
    {
        <MudTable Class="stable" Height="611px" Items="_extractLogsList" Context="obj" Virtualize="false" FixedHeader="true" Elevation="0" HorizontalScrollbar="true" Dense="false" Hover="true" Bordered="false" Striped="true" Filter="new Func<ExtractLogsModel,bool>(FilterFunc1)">
            <HeaderContent>
                <MudTh Class="col-2" Style="background: #e9ecef; font-weight: 600; font-size: 16px;">Extracted By</MudTh>
                <MudTh Class="col-1" Style="background: #e9ecef; font-weight: 600; font-size: 16px;">Action</MudTh>
                <MudTh Class="col-1" Style="background: #e9ecef; font-weight: 600; font-size: 16px;text-align:center">Type</MudTh>
                <MudTh Class="col-3" Style="background: #e9ecef; font-weight: 600; font-size: 16px;">Description</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: 600; font-size: 16px;">Started On</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: 600; font-size: 16px;">Stopped On</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: 600; font-size: 16px;">Extracted On</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: 600; font-size: 16px;text-align:center">Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @if (obj.EmployeeUserId == 0)
                    {
                        <MudIcon Icon="@Icons.Custom.Brands.Discord" /> @* <span style="font-weight:600">Bot</span> *@
                    }
                    else
                    {
                        var emp = empList.Where(e => e.Id == obj.EmployeeUserId).FirstOrDefault();
                        @if (emp != null)
                        {
                            <div class="d-flex flex-column">
                                <div style="font-weight: 600;">@emp?.FirstName @emp?.LastName</div>
                            </div>
                        }
                    }
                </MudTd>
                <MudTd Style="font-weight:600">
                    @if (obj.Action.Equals("Extract"))
                    {
                        <span style="color: #0084ff">@obj.Action</span>
                    }
                    else
                    {
                        <span style="color: #be1313">@obj.Action</span>
                    }
                </MudTd>
                <MudTd Style="text-align:center">
                    @if (obj.Type.Equals("Ongoing"))
                    {
                        <span style="color: #7567b8">@obj.Type</span>
                    }
                    else if (obj.Type.Equals("Stop"))
                    {
                        <span style="color: #27374d">@obj.Type</span>
                    }
                    else if (obj.Type.Equals("Error"))
                    {
                        <span style="color: #be1313">@obj.Type</span>
                    }
                    else if (obj.Type.Equals("Start"))
                    {
                        <span style="color: #fb7a1b">@obj.Type</span>
                    }
                    else
                    {
                        <span style="color: #397763">@obj.Type</span>
                    }
                </MudTd>
                <MudTd>@obj.Description</MudTd>
                <MudTd>
                    <div class="d-flex flex-column">
                        @if (obj.Date_Start.Date.ToString("MM-dd-yyyy") == "01-01-0001")
                        {
                            <span>--</span>
                        }
                        else
                        {
                            <div style="font-weight:600">@obj.Date_Start.ToString("hh:mm tt")</div>
                            <div style="font-size: 12px;color: #757A90;">@obj.Date_Start.ToString("MMM dd yyyy")</div>
                        }
                    </div>
                </MudTd>
                <MudTd>
                    <div class="d-flex flex-column">
                        @if (obj.Date_Stop.Date.ToString("MM-dd-yyyy") == "12-31-9999" || obj.Date_Stop.Date.ToString("MM-dd-yyyy") == "01-01-0001")
                        {
                            <span>--</span>
                        }
                        else
                        {
                        <div style="font-weight:600">@obj.Date_Stop.ToString("hh:mm tt")</div>
                        <div style="font-size: 12px;color: #757A90;">@obj.Date_Stop.ToString("MMM dd yyyy")</div>
                        }
                    </div>
                </MudTd>
                <MudTd>@obj.Date_Extract.ToString("MMM dd yyyy")</MudTd>
                <MudTd Style="text-align:center">
                    @if (obj.Status.Equals("Processing"))
                    {
                        <MudChip Variant="Variant.Text" Color="Color.Warning" Style="color: #ff8000;">@obj.Status</MudChip>
                    }
                    else if (obj.Status.Equals("Failed"))
                    {
                        <MudChip Variant="Variant.Text" Color="Color.Error" Style="color: #be1313;">@obj.Status</MudChip>
                    }
                    else
                    {
                        <MudChip Variant="Variant.Text" Color="Color.Success" Style="color: #397763;">@obj.Status</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 15, 35, int.MaxValue }" InfoFormat="@($"Right {infoFormat}")" HorizontalAlignment="HorizontalAlignment.Right" />
            </PagerContent>
        </MudTable>
    }
</div>

