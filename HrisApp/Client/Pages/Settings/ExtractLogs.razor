    private async Task OnUpdateIPStatus(string _status)
    {
        string _type = DateTime.Now.ToString("tt");
        bool _isAM = false;
        bool _isPM = false;
        if (_type == "AM")
        {
            _isAM = true;
            _isPM = false;
        }
        else if (_type == "PM")
        {
            _isAM = false;
            _isPM = true;
        }

        if(_status == "Close")
        {
            _isAM = false;
            _isPM = false;
        }

        var _bioObj = await BioIPService.GetSingleObj(SelectedLoc);        
        BioIPModel _model = new BioIPModel()
            {
                Id = _bioObj.Id,
                Location = _bioObj.Location,
                IP_Address = _bioObj.IP_Address,
                Port = _bioObj.Port,
                Device_Info = _bioObj.Device_Info,
                Machine = _bioObj.Machine,
                Machine_Reg = _bioObj.Machine_Reg,
                Is_AM = _isAM,
                Is_PM = _isPM,
                Status = _bioObj.Status,
                Res_Status = _status
            };

        await BioIPService.UpdateObj(_model);
    }

    private async Task OnCleanLogs()
    {
        _processingClean = true;
        _toastService.ShowInfo("Archiving. Please wait...");

        var res = await ExtractLogsService.CleanLogs();
        if (res == "Success" || res == "NoLogs")
        {
            _processingClean = false;
            _toastService.ShowSuccess("Archiving succeeded.");
            await LoadList();
            return;
        }
        else
        {
            _processingClean = false;
            _toastService.ShowError("Archiving failed.");
            await LoadList();
            return;
        }
    }


    private string searchString1 = "";
    private bool FilterFunc1(ExtractLogsModel area) => FilterFunc(area, searchString1);

    private bool FilterFunc(ExtractLogsModel area, string searchString)
    {

        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (area.Description.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }
