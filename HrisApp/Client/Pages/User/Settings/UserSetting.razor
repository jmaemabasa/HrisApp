
<MudDialog Style="background: #e9ecef">
    <DialogContent>
        <div class="flex-cointainer">
            <div class="row">
                <div class="col-12" style="font-size: 20px;font-weight: bold;color: #27374d;margin-top: 8px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>Settings</div>
                        <div><MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="close" OnClick="Cancel" Style="color: #27374d;" /></div>
                    </div>
                </div>
            </div>
            <MudTabs Elevation="0" Rounded="true" Position="MudBlazor.Position.Left" Class="my-6">
                <MudTabPanel Icon="@Icons.Material.Rounded.ManageAccounts" Text="Account">
                    <div class="flex-grow-1" style="padding: 4px 8px 12px 16px;">
                        <div class="row">
                            <div class="col-12" style="font-weight: 500;margin-bottom: 8px;">
                                Account
                            </div>
                        </div>

                        @if (!Cmb_IsUsername)
                        {
                            <div class="disabledusername" @onclick="ClickedUsername">
                                <div class="row" style="margin-bottom: 8px;">
                                    <div class="col-12">
                                        <MudSwitch ReadOnly @bind-Checked="@Cmb_IsUsername" Label="Update Username" Color="Color.Primary" />
                                    </div>
                                </div>
                                <div class="row" style="opacity: .1;">
                                    <div class="col-12">
                                        <MudText Typo="Typo.body2">Username</MudText>
                                        <MudTextField Disabled @bind-Value="obj.Username" Variant="Variant.Outlined" Margin="Margin.Dense" Style="margin-bottom: 5px;font-weight: bold;" />
                                    </div>
                                </div>
                                <div class="row" style="opacity: .1;">
                                    <div class="col-12">
                                        <div class="d-grid gap-2">
                                            <button disabled class="btn accountbtnsave" type="button">Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="enabledusername" @onclick="ClickedUsername">
                                <div class="row" style="margin-bottom: 8px;">
                                    <div class="col-12">
                                        <MudSwitch ReadOnly @bind-Checked="@Cmb_IsUsername" Label="Update Username" Color="Color.Primary" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        @if (_showAlert)
                                        {
                                            <MudAlert Severity="@_severity" ShowCloseIcon="true" CloseIconClicked="CloseMe" Class="mb-1 mt-1">@_message</MudAlert>
                                        }
                                    </div>
                                </div>
                                <div class="row" style="margin-bottom:5px">
                                    <div class="col-12">
                                        <MudText Typo="Typo.body2">Username</MudText>
                                        <MudTextField @bind-Value="obj.Username" For="@(() => obj.Username)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <div class="d-grid gap-2">
                                            <button class="btn accountbtnsave" type="button" @onclick="UpdateUsername">Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!Cmb_IsPassword)
                        {
                            <div class="disabledpassword" @onclick="ClickedPassword">
                                <div class="row">
                                    <div class="col-12 divcmb">
                                        <MudSwitch ReadOnly @bind-Checked="@Cmb_IsPassword" Label="Update Password" Color="Color.Primary" Style="opacity: 1 !important" />
                                    </div>
                                </div>
                                <div class="row" style="opacity: .1;">
                                    <div class="col-12">
                                        <MudText Typo="Typo.body2">Current Password</MudText>
                                        <MudTextField Disabled @bind-Value="cpass.CurrentPassword" Variant="Variant.Outlined" Margin="Margin.Dense" Style="margin-bottom: 5px;font-weight: bold;" />
                                    </div>
                                </div>
                                <div class="row" style="opacity: .1;">
                                    <div class="col-12">
                                        <MudText Typo="Typo.body2">New Password</MudText>
                                        <MudTextField Disabled @bind-Value="cpass.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Style="margin-bottom: 5px;font-weight: bold;" />
                                    </div>
                                </div>
                                <div class="row" style="opacity: .1;">
                                    <div class="col-12">
                                        <MudText Typo="Typo.body2">Repeat New Password</MudText>
                                        <MudTextField Disabled @bind-Value="cpass.ConfirmPassword" Variant="Variant.Outlined" Margin="Margin.Dense" Style="margin-bottom: 5px;font-weight: bold;" />
                                    </div>
                                </div>
                                <div class="row" style="opacity: .1;">
                                    <div class="col-12">
                                        <div class="d-grid gap-2">
                                            <button disabled class="btn accountbtnsave" type="button">Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="cpass" OnValidSubmit="ChangePassword">
                                <DataAnnotationsValidator />
                                <div class="enabledpassword" @onclick="ClickedPassword">
                                    <div class="row" style="margin-bottom: 8px;">
                                        <div class="col-12">
                                            <MudSwitch ReadOnly @bind-Checked="@Cmb_IsPassword" Label="Update Password" Color="Color.Primary" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            @if (_showAlert)
                                            {
                                                <MudAlert Severity="@_severity" ShowCloseIcon="true" CloseIconClicked="CloseMe" Class="mb-1 mt-1">@_message</MudAlert>
                                            }
                                        </div>
                                    </div>
                                    <div class="row" style="margin-bottom:5px">
                                        <div class="col-12">
                                            <MudText Typo="Typo.body2">Current Password</MudText>
                                            <MudTextField @bind-Value="cpass.CurrentPassword" For="@(() => cpass.CurrentPassword)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </div>
                                    </div>
                                    <div class="row" style="margin-bottom:5px">
                                        <div class="col-12">
                                            <MudText Typo="Typo.body2">New Password</MudText>
                                            <MudTextField @bind-Value="cpass.Password" For="@(() => cpass.Password)" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ButtonTestclick" AdornmentAriaLabel="Show Password" />
                                        </div>
                                    </div>
                                    <div class="row" style="margin-bottom:5px">
                                        <div class="col-12">
                                            <MudText Typo="Typo.body2">Repeat New Password</MudText>
                                            <MudTextField @bind-Value="cpass.ConfirmPassword" For="@(() => cpass.ConfirmPassword)" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="@CPasswordInput" Adornment="Adornment.End" AdornmentIcon="@CPasswordInputIcon" OnAdornmentClick="CButtonTestclick" AdornmentAriaLabel="Show Password" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="d-grid gap-2">
                                                <button class="btn accountbtnsave" type="submit">Save</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
</MudDialog>
