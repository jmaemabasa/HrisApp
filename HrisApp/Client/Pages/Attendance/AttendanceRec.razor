@page "/attendancerecords"
@using HrisApp.Shared.Models.DummyModel

@attribute [Authorize(Roles = "CadAdmin, SysAdmin, GenAdmin, HR")]

<PageTitle>Attendance</PageTitle>

<style>
    /*UPLOAD FILE*/
    .btnUplaod {
        background-color: #f0f0f0 !important;
        padding: 12px 12px;
        color: slategrey;
        border-left: 2px solid #ebe8e8;
    }

        .btnUplaod:hover {
            background-color: slategrey !important;
            padding: 12px 12px;
            color: #f0f0f0;
            /*transform: scale(1.1);*/
            border: none;
        }

    .btnDiaSave {
        color: #fafaf5;
        background-color: #427D9D !important;
        transition: all .5s ease;
    }

        .btnDiaSave:hover {
            transform: scale(1.1);
            color: #fafaf5;
            background-color: #245e7d !important;
        }

    .btnDiaCancel {
        padding-left: 15px;
        padding-right: 13px;
        color: #BE1313;
        background-color: #EABCBB !important;
        transition: all .5s ease;
    }

        .btnDiaCancel:hover {
            transform: scale(1.1);
            background-color: #BE1313 !important;
            color: #fafaf5;
        }
    /*END UPLOAD FILE*/
</style>

<div class="mb-5">
    <div class="d-flex flex-row mt-5 justify-content-between align-items-center">
        <span style="font-size: x-large;font-weight: 600;color: #424242;">Attendance Records</span>
        <AuthorizeView Roles="CadAdmin, SysAdmin, GenAdmin, HR">
            <Authorized>
                <div class="d-flex gap-3">
                    @* <button class="Btn" @onclick="OpenUploadDialog">
                    <div class="sign"><MudIcon Icon="@Icons.Material.Rounded.Upload"></MudIcon></div>
                    <div class="text">Upload File</div>
                    </button> *@
                    <MudButton OnClick="OpenAddDialog" Variant="Variant.Filled" Size="Size.Medium" StartIcon="@Icons.Material.Rounded.Add" Class="btnadd"> Record</MudButton>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="box w-auto">
    <div class="d-flex justify-content-end">
        <div class="ssize">
            <MudTextField DisableUnderLine @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="tsearch mb-5" Immediate=true Margin="Margin.Dense" />
        </div>
    </div>
    @if (_attendanceList == null || _attendanceList.Count == 0)
    {
        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-7" hidden="@_isVisible" />

        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="auto" hidden="@_isVisible" />
        <MudCardContent hidden="@_isVisible">
            <MudSkeleton Width="30%" Height="42px;" />
            <MudSkeleton Width="80%" />
            <MudSkeleton Width="100%" />
        </MudCardContent>
        <MudCardActions hidden="@_isVisible">
            <MudSkeleton Width="64px" Height="40px" Class="ml-2" />
            <MudSkeleton Width="105px" Height="40px" Class="ml-3" />
        </MudCardActions>
        @if (_isVisible == true)
        {
            <div class="divnodata">
                <MudImage Src="images/nodata.png" Alt="No Data" Width="332" Height="220" Class="rounded-lg" />
                <span class="nodataspan">No Data Available</span>
            </div>
        }
    }
    else
    {
        <MudTable Class="stable" Height="611px" Items="_attendanceList" Context="obj" Virtualize="false" FixedHeader="true" Elevation="0" HorizontalScrollbar="true" Dense="true" Hover="true" Bordered="false" Striped="true" Filter="new Func<BioAttendanceDummy,bool>(FilterFunc1)">
            <HeaderContent>
                <MudTh Class="" Style="background: #e9ecef; font-weight: bold; font-size: 16px;">Employee</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: bold; font-size: 16px;">Biometric ID</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: bold; font-size: 16px;">Date</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: bold; font-size: 16px;">Type</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: bold; font-size: 16px;">IP Address</MudTh>
                <MudTh Class="" Style="background: #e9ecef; font-weight: bold; font-size: 16px;">Remarks</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @{
                        var verid = payList?.FirstOrDefault(d => d.BiometricID == Convert.ToString(obj.IndRegID))?.Verify_Id;
                    }
                    @if (!string.IsNullOrEmpty(verid))
                    {
                        var emp = empList.Where(e => e.Verify_Id.Equals(verid)).FirstOrDefault();
                        var subpos = PositionService.SubPositionTs.Where(e=>e.Id == emp?.PositionId).FirstOrDefault();
                        <div class="d-flex flex-column">
                            <div style="font-weight: 600;">@emp?.FirstName @emp?.LastName</div>
                            <div style="font-size: 13px;color: #757A90;">@subpos?.Description</div>
                        </div>
                    }
                </MudTd>
                <MudTd>@obj.IndRegID</MudTd>
                <MudTd>
                    <div class="d-flex flex-column">
                        <div style="font-weight:600">@obj.TimeOnlyRecord.ToString("hh:mm tt")</div>
                        <div style="font-size: 12px;color: #757A90;">@obj.DateOnlyRecord.ToString("MMM dd yyyy")</div>
                    </div>
                </MudTd>
                <MudTd>@obj.AttendanceType</MudTd>
                <MudTd>@obj.IPAddress</MudTd>
                <MudTd>@obj.Remarks</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 15, 35, int.MaxValue }" InfoFormat="@($"Right {infoFormat}")" HorizontalAlignment="HorizontalAlignment.Right" />
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    public List<BioAttendanceDummy> _attendanceList = new();
    private List<EmployeeT> empList = new();
    private List<Emp_PayrollT> payList = new();
    private string infoFormat = "{first_item}-{last_item} of {all_items}";

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(300);
        empList = await EmployeeService.GetEmployeeList();
        payList = await PayrollService.GetPayrollList();
        await PositionService.GetSubPosition();

        StateService.OnChange += OnStateChanged;
        await LoadList();

        if (_attendanceList == null || _attendanceList.Count == 0)
        {
            _isVisible = true;
        }
    }
    private async Task LoadList()
    {
        var biorecord = await BioService.GetAttendanceRecList();
        _attendanceList.Clear();
        foreach (var item in biorecord)
        {
            EmployeeT? emp = new();
            var pay = payList.Where(e => e.BiometricID.Equals(item.IndRegID.ToString())).FirstOrDefault();
            BioAttendanceDummy dummymodel = new();
            if (pay == null)
            {
                dummymodel = new()
                    {
                        Id = item.Id,
                        Verify_Id = "",
                        FirstName = "",
                        LastName = "",
                        MachineNumber = item.MachineNumber,
                        IndRegID = item.IndRegID,
                        DateTimeRecord = item.DateTimeRecord,
                        DateOnlyRecord = item.DateOnlyRecord,
                        TimeOnlyRecord = item.TimeOnlyRecord,
                        AttendanceType = item.AttendanceType,
                        IPAddress = item.IPAddress,
                        Remarks = item.Remarks
                    };
            }
            else
            {
                emp = empList.Where(e => e.Verify_Id.Equals(pay.Verify_Id)).FirstOrDefault();
                dummymodel = new()
                    {
                        Id = item.Id,
                        Verify_Id = emp!.Verify_Id,
                        FirstName = emp!.FirstName,
                        LastName = emp!.LastName,
                        MachineNumber = item.MachineNumber,
                        IndRegID = item.IndRegID,
                        DateTimeRecord = item.DateTimeRecord,
                        DateOnlyRecord = item.DateOnlyRecord,
                        TimeOnlyRecord = item.TimeOnlyRecord,
                        AttendanceType = item.AttendanceType,
                        IPAddress = item.IPAddress,
                        Remarks = item.Remarks
                    };
            }


            _attendanceList.Add(dummymodel);
        }

        StateService.SetState("AttendanceRecList", _attendanceList.OrderByDescending(e=>e.TimeOnlyRecord).ToList());
    }

    private void OnStateChanged()
    {
        // Handle state changes, e.g., update the areaList
        _attendanceList = StateService.GetState<List<BioAttendanceDummy>>("AttendanceRecList");
        StateHasChanged();
    }

    //LOADING
    public bool _isVisible;

    private void OpenUploadDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small, DisableBackdropClick=true };
        DialogService.Show<AttendanceUploadFileDialog>("", options);
    }

    private void OpenAddDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, DisableBackdropClick = true };
        DialogService.Show<AddAttendanceRec>("New Record", options);
    }

    private string searchString1 = "";
    private bool FilterFunc1(BioAttendanceDummy area) => FilterFunc(area, searchString1);

    private bool FilterFunc(BioAttendanceDummy area, string searchString)
    {

        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (area.IndRegID.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (area.DateOnlyRecord.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (area.DateOnlyRecord.ToString("MMM dd yyyy").Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (area.TimeOnlyRecord.ToString("HH:mm tt").Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (area.FirstName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (area.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (area.IPAddress.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (area.AttendanceType.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }
}
